{
  "name": "kuku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-first language learning app built with React, TypeScript, and Dexie.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
